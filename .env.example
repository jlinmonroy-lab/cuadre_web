# Cuadre (cuadre-web) · plantilla de variables de entorno (SPEC-W-001 §5.4).
# Copia a .env (backend) y a frontend/.env.local (frontend). NO commitees valores reales (RES-07).
# Todos los valores de abajo son marcadores de posición o valores de la pila local de desarrollo.

# --- Backend ---
APP_ENV=local                       # local | staging | production
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000   # único origen CORS permitido

# --- Supabase (región UE; en local, la pila de la CLI) ---
SUPABASE_URL=http://127.0.0.1:54321
# Los tokens se verifican por JWKS (ES256). En local, la clave de firma sale de `npm run gen:signing-key`.
# Solo cuadre.cli. Nunca el frontend ni rutas que actúan en nombre de un usuario.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Contraseña del primer administrador, solo para `python -m cuadre.cli create-admin`
ADMIN_PASSWORD=

# --- Conexiones a Postgres ---
# Toda petición de usuario: rol cuadre_app (NOINHERIT, sin BYPASSRLS); la identidad se fija con SET LOCAL ROLE.
DATABASE_URL=postgresql://cuadre_app:<password>@127.0.0.1:54322/postgres
# Solo cuadre.jobs y cuadre.cli: rol cuadre_jobs (miembro de service_role).
DATABASE_SERVICE_URL=postgresql://cuadre_jobs:<password>@127.0.0.1:54322/postgres
# SOLO PARA LOS TESTS (crea usuarios y estados de prueba). Ningún código de la aplicación la lee.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Clave publicable de la pila local (`npx supabase status`); permite a los tests `live` pedir tokens reales a GoTrue.
TEST_SUPABASE_ANON_KEY=<publishable-key>

# --- Frontend (solo variables públicas, prefijo NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Servicio de agentes (cuadre-agents): SPEC-W-002 y siguientes ---
# Vacío = cliente simulado con los fixtures de contracts/examples/. Con valor = cliente HTTP real.
AGENTS_BASE_URL=
AGENTS_API_KEY=
# Firma del token MCP derivado (aud=cuadre-mcp, scope=mcp:read, exp <= 5 min): SPEC-W-011
MCP_TOKEN_SECRET=<random-32-bytes>

# --- Jobs programados: SPEC-W-012 y SPEC-W-014 ---
INTERNAL_JOBS_SECRET=<random-32-bytes>

# --- Correo transaccional (proveedor pendiente, ADR-0008) ---
EMAIL_PROVIDER=console
EMAIL_FROM=Cuadre <no-reply@example.test>
