{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "usuario",
              "gestor",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "const": "active",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "status"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "Forma de todo error de la API. Se declara para que aparezca en OpenAPI.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "detail"
        ],
        "title": "ProblemDetails",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "JWT de Supabase Auth",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "API de cuadre-web: facturación, contabilidad y borradores de los modelos 303 y 130.",
    "title": "Cuadre API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Sin sesión, o sesión inválida o caducada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Cuenta suspendida o sin perfil"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No se puede comprobar la sesión ahora mismo"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Obtener la cuenta autenticada y su rol",
        "tags": [
          "cuenta"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Comprobar que la API responde",
        "tags": [
          "sistema"
        ]
      }
    }
  }
}
