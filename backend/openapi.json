            "items": {
              "$ref": "#/components/schemas/ReviewTaxLine"
            },
            "maxItems": 10,
            "title": "Tax Breakdown",
            "type": "array"
          },
          "total_cents": {
            "anyOf": [
              {
                "maximum": 99999999999999.0,
                "minimum": -99999999999999.0,
