  "info": {
    "summary": "API de cuadre-web: facturación, contabilidad y borradores de los modelos 303 y 130.",
    "title": "Cuadre API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/documents": {
      "get": {
        "operationId": "list_documents",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  },
                  "title": "Response List Documents",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Sin sesión, o sesión inválida o caducada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "El rol de la cuenta no puede usar documentos (solo `usuario`) o la cuenta está suspendida"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Listar los documentos de la persona",
        "tags": [
          "documentos"
        ]
      },
      "post": {
        "operationId": "upload_document",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
