{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "1.0.0",
  "$defs": {
    "AbstentionData": {
      "properties": {
        "reason": {
          "$ref": "#/$defs/AbstentionReason"
        },
        "referral": {
          "anyOf": [
            {
              "enum": [
                "gestor",
                "asesor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A quién se deriva. Obligatorio cuando reason es professional_judgment: «gestor» solo si user_context.has_gestor es true; en otro caso, «asesor».",
          "title": "Referral"
        }
      },
      "required": [
        "reason",
        "referral"
      ],
      "title": "AbstentionData",
      "type": "object"
    },
    "AbstentionFrame": {
      "properties": {
        "event": {
          "const": "abstention",
          "default": "abstention",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/AbstentionData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "AbstentionFrame",
      "type": "object"
    },
    "AbstentionReason": {
      "enum": [
        "no_source",
        "professional_judgment",
        "out_of_scope"
      ],
      "title": "AbstentionReason",
      "type": "string"
    },
    "ChatErrorCode": {
      "enum": [
        "unauthorized",
        "invalid_request",
        "upstream_error",
        "tool_error",
        "timeout"
      ],
      "title": "ChatErrorCode",
      "type": "string"
    },
    "CitationData": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "description": "Organismo emisor de la fuente oficial, por ejemplo AEAT o BOE.",
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "valid_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fecha de vigencia del documento en la base de conocimiento.",
          "title": "Valid As Of"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "valid_as_of",
        "quote"
      ],
      "title": "CitationData",
      "type": "object"
    },
    "CitationFrame": {
      "properties": {
        "event": {
          "const": "citation",
          "default": "citation",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/CitationData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "CitationFrame",
      "type": "object"
    },
    "DoneData": {
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/FinishReason"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "finish_reason",
        "trace_id"
      ],
      "title": "DoneData",
      "type": "object"
    },
    "DoneFrame": {
      "properties": {
        "event": {
          "const": "done",
          "default": "done",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/DoneData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "DoneFrame",
      "type": "object"
    },
    "ErrorData": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ChatErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorData",
      "type": "object"
    },
    "ErrorFrame": {
      "properties": {
        "event": {
          "const": "error",
          "default": "error",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ErrorData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "ErrorFrame",
      "type": "object"
    },
    "FinishReason": {
      "enum": [
        "stop",
        "abstained",
        "length",
        "error"
      ],
      "title": "FinishReason",
      "type": "string"
    },
    "TokenData": {
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        }
      },
      "required": [
        "delta"
      ],
      "title": "TokenData",
      "type": "object"
    },
    "TokenFrame": {
      "properties": {
        "event": {
          "const": "token",
          "default": "token",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TokenData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "TokenFrame",
      "type": "object"
    },
    "ToolCallData": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "started",
            "finished",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "ToolCallData",
      "type": "object"
    },
    "ToolCallFrame": {
      "properties": {
        "event": {
          "const": "tool_call",
          "default": "tool_call",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ToolCallData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "ToolCallFrame",
      "type": "object"
    },
    "UsageData": {
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_eur": {
          "anyOf": [
            {
              "description": "Coste en euros como cadena decimal (hasta seis decimales).",
              "examples": [
                "0.004200"
              ],
              "pattern": "^\\d{1,6}\\.\\d{2,6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Eur"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_eur"
      ],
      "title": "UsageData",
      "type": "object"
    },
    "UsageFrame": {
      "properties": {
        "event": {
          "const": "usage",
          "default": "usage",
          "title": "Event",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/UsageData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "UsageFrame",
      "type": "object"
    }
  },
  "description": "Un frame de la respuesta SSE. El flujo termina con `done` o con `error`.",
  "discriminator": {
    "mapping": {
      "abstention": "#/$defs/AbstentionFrame",
      "citation": "#/$defs/CitationFrame",
      "done": "#/$defs/DoneFrame",
      "error": "#/$defs/ErrorFrame",
      "token": "#/$defs/TokenFrame",
      "tool_call": "#/$defs/ToolCallFrame",
      "usage": "#/$defs/UsageFrame"
    },
    "propertyName": "event"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TokenFrame"
    },
    {
      "$ref": "#/$defs/CitationFrame"
    },
    {
      "$ref": "#/$defs/ToolCallFrame"
    },
    {
      "$ref": "#/$defs/AbstentionFrame"
    },
    {
      "$ref": "#/$defs/UsageFrame"
    },
    {
      "$ref": "#/$defs/DoneFrame"
    },
    {
      "$ref": "#/$defs/ErrorFrame"
    }
  ],
  "title": "ChatStreamFrame"
}
