    {
      "name": "borrador_trimestre",
      "title": "Borrador de los modelos 303 y 130",
      "description": "Borrador orientativo del modelo 303 (IVA) y/o 130 (IRPF) de un trimestre, casilla a casilla y con las facturas que componen cada casilla. Es un borrador: no se presenta ante la AEAT. Explica el resultado con estas cifras; no las recalcules.",
      "inputSchema": {
        "properties": {
          "anio": {
            "maximum": 2100,
            "minimum": 2000,
            "title": "Anio",
            "type": "integer"
          },
          "trimestre": {
            "maximum": 4,
            "minimum": 1,
            "title": "Trimestre",
            "type": "integer"
          },
          "modelo": {
            "default": "ambos",
            "enum": [
              "303",
              "130",
              "ambos"
            ],
            "title": "Modelo",
            "type": "string"
          }
        },
        "required": [
          "anio",
          "trimestre"
        ],
        "title": "BorradorTrimestreInput",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "BorradorModelo": {
            "properties": {
              "modelo": {
                "enum": [
                  "303",
                  "130"
                ],
                "title": "Modelo",
                "type": "string"
              },
              "casillas": {
                "items": {
                  "$ref": "#/$defs/Casilla"
                },
                "title": "Casillas",
                "type": "array"
              },
              "resultado_cents": {
                "description": "Importe absoluto del resultado.",
                "title": "Resultado Cents",
                "type": "integer"
              },
              "resultado_tipo": {
                "enum": [
                  "a_ingresar",
                  "a_compensar",
                  "cero"
                ],
                "title": "Resultado Tipo",
                "type": "string"
              }
            },
            "required": [
              "modelo",
              "casillas",
              "resultado_cents",
              "resultado_tipo"
            ],
            "title": "BorradorModelo",
            "type": "object"
          },
          "Casilla": {
            "properties": {
              "casilla": {
                "description": "Número de casilla tal como aparece en el modelo, por ejemplo «07».",
                "title": "Casilla",
                "type": "string"
              },
              "concepto": {
                "title": "Concepto",
                "type": "string"
              },
              "importe_cents": {
                "title": "Importe Cents",
                "type": "integer"
              },
              "facturas": {
                "description": "Documentos que componen la casilla. Vacío si es un total.",
                "items": {
                  "$ref": "#/$defs/FacturaRef"
                },
                "title": "Facturas",
                "type": "array"
              }
            },
            "required": [
              "casilla",
              "concepto",
              "importe_cents",
              "facturas"
            ],
            "title": "Casilla",
            "type": "object"
          },
          "FacturaRef": {
            "properties": {
              "id": {
                "format": "uuid",
                "title": "Id",
                "type": "string"
              },
              "tipo": {
                "enum": [
                  "emitida",
                  "gasto"
                ],
                "title": "Tipo",
                "type": "string"
              },
              "numero": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Numero"
              },
              "contraparte": {
                "title": "Contraparte",
                "type": "string"
              }
            },
            "required": [
              "id",
              "tipo",
              "numero",
              "contraparte"
            ],
            "title": "FacturaRef",
            "type": "object"
          }
        },
        "properties": {
          "anio": {
            "title": "Anio",
            "type": "integer"
          },
          "trimestre": {
            "title": "Trimestre",
            "type": "integer"
          },
          "plazo_presentacion": {
            "format": "date",
            "title": "Plazo Presentacion",
            "type": "string"
          },
          "orientativo": {
            "const": true,
            "description": "Siempre true: es un borrador, no se presenta ante la AEAT.",
            "title": "Orientativo",
            "type": "boolean"
          },
          "aviso": {
            "title": "Aviso",
            "type": "string"
          },
          "modelos": {
            "items": {
              "$ref": "#/$defs/BorradorModelo"
            },
            "title": "Modelos",
            "type": "array"
          },
          "moneda": {
            "const": "EUR",
            "default": "EUR",
            "title": "Moneda",
            "type": "string"
          },
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          }
        },
        "required": [
          "anio",
          "trimestre",
          "plazo_presentacion",
          "orientativo",
          "aviso",
          "modelos",
          "moneda",
          "as_of"
        ],
        "title": "BorradorTrimestreOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "gastos_por_categoria",
      "title": "Gastos por categoría",
      "description": "Gastos registrados agrupados por categoría (software, suministros, asesoría...) para un año, un mes o un trimestre. Indica «mes» o «trimestre», no ambos; sin ninguno, devuelve el año completo.",
      "inputSchema": {
        "properties": {
          "anio": {
            "maximum": 2100,
            "minimum": 2000,
            "title": "Anio",
            "type": "integer"
          },
          "mes": {
            "anyOf": [
              {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Excluyente con «trimestre».",
            "title": "Mes"
          },
          "trimestre": {
            "anyOf": [
              {
                "maximum": 4,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
