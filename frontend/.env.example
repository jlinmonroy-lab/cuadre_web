# Variables del frontend. Copia este archivo a `.env.local` (no se versiona) y rellénalo.
# Next.js solo lee el .env de ESTA carpeta, no el de la raíz: aquí solo caben variables públicas (NEXT_PUBLIC_*), nunca la clave de
# servicio ni la URL de la base de datos (SPEC-W-001 T-15).

# Supabase local (`npx supabase status`): URL de la API y clave publicable (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# API de cuadre-web (uvicorn)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
