{
  "name": "cuadre-web",
  "private": true,
  "description": "Raíz del monorepo: solo la CLI de Supabase y atajos. Cada parte tiene su propio package.json o pyproject.toml.",
  "engines": { "node": ">=24" },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "gen:signing-key": "node scripts/gen-signing-key.mjs",
    "env:local": "node scripts/write-env.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "supabase": "3.0.0"
  }
}
